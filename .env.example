# Get this API token from https://zerro.app/token
ZENMONEY_TOKEN=

# Remote HTTP mode (stdio is the default when MCP_TRANSPORT is omitted)
MCP_TRANSPORT=http
HTTP_ADDR=:8080
MCP_BASE_URL=https://zm.abrekhov.cloud

# Generate independent high-entropy secrets; never commit their values.
MCP_OAUTH_PASSWORD=
MCP_SIGNING_KEY=
